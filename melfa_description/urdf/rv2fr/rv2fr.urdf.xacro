<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rv2fr">

    <!-- Enable setting arguments from the launch file -->
    <xacro:arg name="use_sim" default="true" />
    <xacro:arg name="use_fake_hardware" default="false" />
    <xacro:arg name="prefix" default="" />
    <xacro:arg name="robot_ip" default="192.168.0.20" />
    <xacro:arg name="robot_port" default="10000" />
    <xacro:arg name="initial_positions_file" default="initial_positions_rv.yaml" />
    <xacro:arg name="controller_config" default="custom_io_params.yaml" />
    <xacro:arg name="controller_type" default="" />
    <xacro:arg name="scara" default="0" />
    <xacro:arg name="is_j7" default="0" />
    <xacro:arg name="j7_linear" default="0" />
    <xacro:arg name="is_j8" default="0" />
    <xacro:arg name="j8_linear" default="0" />
    <xacro:arg name="packet_lost_log" default="1" />
    <xacro:arg name="simulation_controllers" default="" />
    <!-- Include the gripper settings -->
    <xacro:arg name="sim_gazebo" default="$(arg use_sim)" />
    <xacro:arg name="use_mock_hardware" default="$(arg use_fake_hardware)" />
    <!-- After your existing arguments, before the include -->

    <!-- Import urdf file -->
    <!-- Here we include a macro file, so later we still need to call the macro to spawn the manipulator -->
    <xacro:include filename="$(find melfa_description)/urdf/rv2fr/rv2fr_macro.xacro" />
    <!-- Import ros2_control description -->
    <!-- Here this xacro file is actually a macro file, so later we still need to call the macro -->
    <xacro:include filename="$(find melfa_description)/ros2_control/rv2fr.hardware.xacro" />

    <!-- Use world link to fix robot -->
    <link name="$(arg prefix)world"/>
    <!-- Spawn the manipulator -->
    <xacro:rv2fr parent="$(arg prefix)world" prefix="$(arg prefix)">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:rv2fr>

    <!-- Import robotiq_hand_e_gripper -->
    <!-- Here this file is a xacro, in it it calls macro to spawn the gripper -->

    <!-- Use this if parameters are set from the launch file, otherwise delete -->
    <xacro:arg name="parent" default="$(arg prefix)rv2fr_default_tcp" />
    <xacro:arg name="mock_sensor_commands" default="false" />

    <xacro:include filename="$(find robotiq_description)/urdf/robotiq_hand_e_macro.urdf.xacro"/>
    <xacro:include filename="$(find robotiq_description)/urdf/hand_e.ros2_control.xacro"/>

    <!-- create link fixed to the "world" -->
    <!-- <link name="base_link" /> -->
    <!-- Load robot's macro with parameters -->
    <!-- set prefix if multiple robots are used -->
    <xacro:robotiq_hande prefix="$(arg prefix)" parent="$(arg parent)">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:robotiq_hande>

    <xacro:robotiq_hande_ros2_control
        name="robotiq_hande"
        prefix="$(arg prefix)"
        sim_gazebo="$(arg sim_gazebo)"
        use_mock_hardware="$(arg use_mock_hardware)" />

    <xacro:rv2fr_hardware
        name="rv2fr" 
        prefix="$(arg prefix)"
        robot_ip="$(arg robot_ip)" 
        robot_port="$(arg robot_port)"
        scara="$(arg scara)"
        is_j7="$(arg is_j7)"
        j7_linear="$(arg j7_linear)"
        is_j8="$(arg is_j8)"
        j8_linear="$(arg j8_linear)"
        initial_positions_file="$(arg initial_positions_file)"
        controller_config="$(arg controller_config)"
        use_sim="$(arg use_sim)" 
        use_fake_hardware="$(arg use_fake_hardware)"
        controller_type="$(arg controller_type)"
        packet_lost_log="$(arg packet_lost_log)"
    />

    <xacro:if value="$(arg use_sim)">
        <gazebo reference="world">
        </gazebo>
        <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg simulation_controllers)</parameters>
            <controller_manager_node_name>$(arg prefix)controller_manager</controller_manager_node_name>
        </plugin>
        </gazebo>
    </xacro:if>

</robot>